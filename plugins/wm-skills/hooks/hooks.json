{
  "description": "Hook di wm-skills: il lint di wm-context-doctor, il controllo sugli identificatori, la mod wm-plan-anchors",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^wm-skills:wm-context-doctor$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/verifica-lint-eseguito.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/identifier-check.sh\""
          }
        ]
      }
    ]
  },
  "modules": ["../mods/wm-plan-anchors/register.tsx"]
}
